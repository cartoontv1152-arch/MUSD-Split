# MUSD Split — environment variables (copy to .env.local; never commit real values)
# On Vercel these come from the Neon integration + `vercel env add`. Locally: `vercel env pull .env.local`.

# Postgres (Neon). All tables live in schema `split`.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@host/db?sslmode=require

# HS256 key for the SIWE session cookie (>= 32 chars). Generate:
#   node -e "process.stdout.write(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Bearer token Vercel Cron sends to /api/cron/daily
CRON_SECRET=

# Optional: override the server-side Mezo testnet RPC (default https://rpc.test.mezo.org)
# MEZO_RPC_URL=

# Optional: canonical site URL for OpenGraph (Vercel sets VERCEL_PROJECT_PRODUCTION_URL automatically)
# NEXT_PUBLIC_SITE_URL=https://musd-split.vercel.app

# Scripts only (never used by the app):
# BASE_URL=http://localhost:3000          # e2e target
# E2E_WALLETS_FILE=/abs/path/test-wallets.json
# DEPLOYER_ENV_FILE=/abs/path/.env.txt    # contracts/scripts/deploy.ts reads PRIVATE_KEY at runtime
