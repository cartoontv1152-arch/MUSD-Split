{
  "name": "musd-split",
  "version": "1.0.0",
  "private": true,
  "description": "Group expense splitting with real MUSD settlement on Mezo testnet",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "e2e:testnet": "tsx scripts/e2e-testnet.ts",
    "contracts:test": "npm --prefix contracts test",
    "contracts:deploy": "npm --prefix contracts run deploy:testnet"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.104.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.10.3",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "viem": "^2.57.11",
    "wagmi": "^2.19.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
